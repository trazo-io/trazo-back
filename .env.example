# Trazo Backend Environment Variables

# Django Configuration
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_NAME=trazo_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Social Authentication Configuration

# Google OAuth 2.0
# Get client ID and secret from: https://console.developers.google.com/
# Instructions:
# 1. Create a new project or select existing
# 2. Enable Google+ API and Google Identity Toolkit API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URIs: http://localhost:3000, http://app.localhost:3000, http://consumer.localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Facebook OAuth 2.0
# Get app ID and secret from: https://developers.facebook.com/
# Instructions:
# 1. Create a new app or select existing
# 2. Add Facebook Login product
# 3. Configure OAuth redirect URIs in app settings
# 4. Add domains: localhost, app.localhost, consumer.localhost
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Apple Sign In
# Get credentials from: https://developer.apple.com/
# Instructions:
# 1. Create App ID with Sign In with Apple capability
# 2. Create Service ID for web authentication
# 3. Create and download private key for Apple authentication
# 4. Configure return URLs and domains
APPLE_CLIENT_ID=your.apple.service.id
APPLE_CLIENT_SECRET=your_generated_jwt_token_here
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
your_apple_private_key_content_here
-----END PRIVATE KEY-----

# CORS and CSRF Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://app.localhost:3000,http://consumer.localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://app.localhost:3000,http://consumer.localhost:3000

# Base URLs for different platforms
BASE_APP_URL=http://app.localhost:3000/
BASE_CONSUMER_URL=http://consumer.localhost:3000/

# Email Configuration (for account verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Other configurations (add as needed)
ENVIRONMENT=development

# Voice logging (see carbon/views.py voice_config + deepgram_token)
#
# Both are OPTIONAL and both degrade quietly, which is exactly why they belong here:
#   DEEPGRAM_API_KEY unset -> /carbon/voice-config/ answers "web_speech_api", so voice falls
#     back to the browser recogniser. No error, no log line, just worse transcription and
#     nothing at all on Safari/iOS.
#   OPENAI_AVAILABLE False or OPENAI_API_KEY unset -> the transcript is parsed by keyword
#     matching instead of GPT (~30-75% confidence rather than field extraction).
# Neither was templated before 2026-08-25, so a new environment silently came up degraded.
DEEPGRAM_API_KEY=
OPENAI_AVAILABLE=False
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
# Billable voice sessions per company per UTC day (0 disables the ceiling).
VOICE_DAILY_SESSION_LIMIT=200

# Redis. Without it prod.py falls back to DummyCache, which stores nothing — so every DRF
# throttle (login 3/min, signup, password reset) silently becomes a no-op and Celery runs
# eager. `backend.security.checks` warns about this on every deploy; setting REDIS_URL is
# what actually turns the protection on.
REDIS_URL=

# Make that warning a hard failure — for CI and staging, never for the environment that
# serves traffic. See backend/security/checks.py for why the default cannot be an Error.
SECURITY_CHECKS_STRICT=False

# Background document builds (documents/services/export_jobs.py). The operation audit dossier
# is built outside the request: `thread` runs it on a daemon thread in the web process (default,
# no extra infrastructure); `worker` makes the web process only enqueue and a separate
# `manage.py run_export_worker` process (a DO worker component) claim and run jobs; `eager`
# builds inside the request and is for tests only.
EXPORT_JOB_RUNNER=thread
# A running build whose heartbeat is older than this many minutes is reported as interrupted.
EXPORT_JOB_STALE_MINUTES=10
