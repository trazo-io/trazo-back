{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadConsumerMediaOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::trazo-media/media/*",
        "arn:aws:s3:::trazo-media/gallery_images/*",
        "arn:aws:s3:::trazo-media/qr_codes/*",
        "arn:aws:s3:::trazo-media/company_logos/*",
        "arn:aws:s3:::trazo-media/product_images/*",
        "arn:aws:s3:::trazo-media/user_images/*",
        "arn:aws:s3:::trazo-media/badges/*"
      ]
    }
  ]
}
