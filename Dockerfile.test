FROM python:3.12-slim

WORKDIR /app

# Install minimal dependencies
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create a simple health check server
RUN echo 'from http.server import HTTPServer, BaseHTTPRequestHandler\n\
import sys\n\
\n\
class HealthHandler(BaseHTTPRequestHandler):\n\
    def do_GET(self):\n\
        if self.path == "/health/" or self.path == "/health":\n\
            self.send_response(200)\n\
            self.send_header("Content-type", "application/json")\n\
            self.end_headers()\n\
            self.wfile.write(b"{\"status\": \"ok\", \"message\": \"Test server running\"}")\n\
        else:\n\
            self.send_response(404)\n\
            self.end_headers()\n\
            self.wfile.write(b"Not Found")\n\
\n\
if __name__ == "__main__":\n\
    server = HTTPServer(("0.0.0.0", 8000), HealthHandler)\n\
    print("Test server starting on port 8000...")\n\
    server.serve_forever()' > /app/test_server.py

EXPOSE 8000

CMD ["python", "/app/test_server.py"]